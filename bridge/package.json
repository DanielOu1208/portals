{
  "name": "portals-host",
  "version": "0.3.3",
  "description": "Runs Claude Code, Codex, Pi, Cursor, Droid, Hermes and OpenCode on your Mac or Linux computer for the Portals app.",
  "license": "MIT",
  "homepage": "https://portals.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielOu1208/portals.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/DanielOu1208/portals/issues"
  },
  "keywords": [
    "portals",
    "claude-code",
    "codex",
    "pi",
    "cursor",
    "hermes",
    "opencode",
    "iphone",
    "tailscale"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "portals-host": "dist/cli.js",
    "portals": "dist/portals.js"
  },
  "files": [
    "dist",
    "!dist/providers/codex/types",
    "README.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "setup": "node src/cli.ts setup",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import ./test/environment.ts --test test/*.test.ts",
    "test:bench": "BENCH_TESTS=1 node --import ./test/environment.ts --test test/bench.test.ts",
    "typecheck": "tsc --noEmit",
    "contract": "node src/gateway/contract.ts --write"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@factory/droid-sdk": "0.10.0",
    "uqr": "0.1.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@opencode/client": "2.2.5"
  },
  "overrides": {
    "@factory/droid-sdk": {
      "uuid": "11.1.1"
    }
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@opencode/client": "2.2.5",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
