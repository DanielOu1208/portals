// The anonymous totals as a Cloudflare Worker, apart from portals-relay so it cannot touch
// it; stats/README.md says how to deploy it and close its page with Cloudflare Access.
{
  "name": "portals-stats",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Served at https://portals-stats.danielou1208.workers.dev only: no preview address per version.
  "workers_dev": true,
  "preview_urls": false,
  // The page's own address, which Cloudflare Access covers; workers.dev stays open for hosts'
  // POST /v1/day, and the Worker refuses everything else there, as it has no Access token.
  "routes": [{ "pattern": "stats.portals.build", "custom_domain": true }],
  // ACCESS_TEAM_DOMAIN ("<team>.cloudflareaccess.com") and ACCESS_AUD (the Access
  // application's AUD tag) are secrets (`wrangler secret put`), so a deploy from this file
  // never blanks them. While either is unset the Worker takes POST /v1/day and refuses
  // everything else.
  "d1_databases": [
    // Made with `wrangler d1 create portals-stats`; its id goes here before the first deploy.
    { "binding": "DB", "database_name": "portals-stats", "database_id": "63eae229-bbcb-4b11-9388-05dcb0664cca", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    // Days sent per caller's address. A host sends at most 7 days at once, and a few hosts
    // can share an address. A namespace_id is any number unique within the account: the
    // relay has 1801 to 1803.
    { "name": "DAY_LIMIT", "namespace_id": "1901", "simple": { "limit": 60, "period": 60 } }
  ],
  // Cloudflare's request logs would keep each caller's address; the Worker logs nothing.
  "observability": { "enabled": false }
}
