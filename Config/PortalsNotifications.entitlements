<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Set in Shared.xcconfig: where the app leaves the agents' avatars, and the Keychain
	     group of the keys hosts seal notifications to. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(PORTALS_APP_GROUP)</string>
	</array>
</dict>
</plist>
